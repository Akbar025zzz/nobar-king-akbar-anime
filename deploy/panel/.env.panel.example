# =====================================================================
# Nobar King Akbar Anime — konfigurasi deployment container (tanpa root)
# Salin ke: deploy/panel/.env.panel  →  cp .env.panel.example .env.panel
# =====================================================================

# Port publik yang dibuka panel (allocation Pterodactyl kamu).
# Kalau egg-nya sudah menyediakan SERVER_PORT/PORT, baris ini boleh dikosongkan.
GATEWAY_PORT=3000

# Port internal (jarang perlu diubah; semua hanya listen di 127.0.0.1)
# NEXT_PORT=3001
# API_PORT=4000
# WAJIK_PORT=4200
# RESOLVER_PORT=4100

# URL publik lengkap (opsional, hanya untuk log & CORS).
# Contoh: https://nobar.domainmu.com  atau  http://203.0.113.10:25500
PUBLIC_URL=

# ---- Sumber anime ----
# otakudesu = sub Indo terlengkap, TAPI sering diblokir Cloudflare untuk IP datacenter.
# oploverz  = jalur alternatif yang terbukti bisa dari IP panel (default di sini).
CONTENT_SOURCE=oploverz

# ---- Film & Series (TMDb) ----
# Kunci publik demo; ganti dengan kunci TMDb milikmu (gratis) untuk produksi.
TMDB_API_KEY=4e44d9029b1270a757cddc766a1bcb63
TMDB_LANGUAGE=id-ID

# ---- Database ----
# embedded = PostgreSQL dijalankan otomatis di dalam container (tanpa root, default)
# external = pakai database lain; isi DATABASE_URL di bawah
PANEL_DB_MODE=embedded
PANEL_PG_PORT=5433
PANEL_PG_USER=nobar
PANEL_PG_PASSWORD=ganti-sandi-database-ini
PANEL_PG_DATABASE=nobar_king
# DATABASE_URL=postgres://user:sandi@host:5432/nama_db

# ---- Rahasia internal (WAJIB diganti) ----
# Buat dengan: openssl rand -hex 32
STREAM_PROXY_SECRET=ganti-dengan-kunci-hmac-acak
RESOLVER_API_KEY=ganti-dengan-kunci-resolver

# ---- Perilaku ----
# 1 = pasang dependensi & build otomatis saat pertama dijalankan
AUTO_SETUP=1
# Chromium dimatikan otomatis saat idle supaya RAM container aman
BROWSER_IDLE_MS=120000
RESOLVER_BROWSER_IDLE_MS=120000
