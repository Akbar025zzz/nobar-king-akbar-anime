[Unit]
Description=Nobar King Akbar Anime (docker compose stack)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Sesuaikan bila proyek diletakkan di folder lain.
WorkingDirectory=/opt/nobar-king-akbar-anime
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
