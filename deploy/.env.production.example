# =====================================================================
# Nobar King Akbar Anime — konfigurasi stack produksi (docker compose)
# Salin ke `.env` di root proyek:  cp deploy/.env.production.example .env
# Lalu ganti semua nilai rahasia di bawah.
# =====================================================================

# ---- URL publik yang dipakai pengunjung (WAJIB) ----
# Tanpa domain: http://<IP-PUBLIK-SERVER>
# Dengan domain + HTTPS: https://nobar.domainmu.com
PUBLIC_URL=http://GANTI_DENGAN_IP_ATAU_DOMAIN

# Port gateway di host (80 di server produksi; 443 hanya jika TLS ditangani nginx container)
GATEWAY_PORT=80

# ---- PostgreSQL ----
POSTGRES_USER=nobar
POSTGRES_DB=nobar_king
# Buat dengan: openssl rand -base64 24
POSTGRES_PASSWORD=GANTI_DENGAN_SANDI_DATABASE_KUAT

# ---- Rahasia internal (WAJIB diganti) ----
# Buat dengan: openssl rand -hex 32
STREAM_PROXY_SECRET=GANTI_DENGAN_KUNCI_HMAC_64_HEX
# Buat dengan: openssl rand -hex 24
RESOLVER_API_KEY=GANTI_DENGAN_KUNCI_RESOLVER
