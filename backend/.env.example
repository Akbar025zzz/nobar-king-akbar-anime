# ===== Nobar King Akbar Anime - Backend =====
NODE_ENV=development
PORT=4000

# Public URL of the frontend (used for CORS + origin checks)
FRONTEND_URL=http://localhost:3000
# Comma separated extra origins allowed for CORS (optional)
CORS_ORIGINS=

# PostgreSQL
DATABASE_URL=postgres://nobar:nobar_dev_password@127.0.0.1:5432/nobar_king

# Sessions
SESSION_COOKIE_NAME=nka_session
SESSION_TTL_DAYS=30

# ===== Content source: wajik-anime-api (sub Indo scrapers) =====
# Base URL of the self-hosted wajik-anime-api (internal service in docker-compose)
WAJIK_API_URL=http://127.0.0.1:4200
# Upstream timeout for one source request (otakudesu is fetched via a browser)
WAJIK_TIMEOUT_MS=60000
# Cache TTL (seconds) for catalog / search / detail / episode metadata
WAJIK_CACHE_TTL=300

# ===== Embed resolver (anime1v-api Puppeteer engine) =====
# Turns player/embed URLs (desustream, vidhide, ...) into direct media URLs
RESOLVER_API_URL=http://127.0.0.1:4100/api/v1/anime
# Internal key only ever used by this backend. NEVER expose to the frontend.
RESOLVER_API_KEY=nobar-internal-dev-key
RESOLVER_TIMEOUT_MS=120000
# Short-lived cache for resolved stream URLs (seconds)
STREAM_CACHE_TTL=600

# ===== Signed stream proxy =====
# HMAC secret for the same-origin stream proxy (pass-through only).
# Change this to a long random string in production.
STREAM_PROXY_SECRET=nobar-local-stream-proxy-secret

# ===== Rate limits (per window) =====
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_SEARCH=60
RATE_LIMIT_STREAM=30
RATE_LIMIT_CREATE_ROOM=10
RATE_LIMIT_CHAT_PER_MINUTE=30

# Room behaviour
ROOM_INACTIVE_CLEANUP_HOURS=12
MAX_ROOM_PARTICIPANTS=50
